<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtlasPca.ExtensionsAI</RootNamespace>
    <Version>0.5.0</Version>
    <!-- Maturity tier of the package: stable | production | experimental (the PCA maturity tiers page defines them). Package tag + assembly metadata. -->
    <Maturity>experimental</Maturity>
    <PackageTags>pca;proof-carrying-authority;microsoft-extensions-ai;maturity-experimental</PackageTags>
    <Description>Atlas Proof-Carrying Authority for Microsoft.Extensions.AI: a guarded AIFunction (every tool call is a proof-carrying action) and a delegating chat client that records provenance.</Description>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>maturity</_Parameter1>
      <_Parameter2>$(Maturity)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="9.7.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AtlasPca/AtlasPca.csproj" />
  </ItemGroup>
</Project>
