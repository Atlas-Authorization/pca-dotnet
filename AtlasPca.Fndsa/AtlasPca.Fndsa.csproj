<Project Sdk="Microsoft.NET.Sdk">
  <!-- A real FN-DSA backend for AtlasPca's Fndsa seam: P/Invoke over libfndsa (built from the flagship's fn-dsa crate with cargo and the capi feature).
       A separate assembly so the core library gains no native dependency. Set ATLAS_PCA_LIBFNDSA to the shared library, or put libfndsa beside the assembly. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtlasPca.Fndsa.Native</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <Version>0.5.0</Version>
    <Description>FN-DSA (draft FIPS 206) backend for AtlasPca, with the libfndsa native library for every supported platform.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AtlasPca/AtlasPca.csproj" />
  </ItemGroup>
  <!-- The native libraries ship per RID in runtimes/<rid>/native (built by the native-package workflow). PackNativeRequired=true (the release job) makes a pack without all of them fail. -->
  <ItemGroup>
    <None Include="runtimes/**/native/*" Pack="true" PackagePath="%(Identity)" Visible="false" />
  </ItemGroup>
  <Target Name="RequireNatives" BeforeTargets="_GetPackageFiles" Condition="'$(PackNativeRequired)' == 'true'">
    <ItemGroup>
      <_Native Include="runtimes/linux-x64/native/libfndsa.so;runtimes/linux-arm64/native/libfndsa.so;runtimes/osx-x64/native/libfndsa.dylib;runtimes/osx-arm64/native/libfndsa.dylib;runtimes/win-x64/native/fndsa.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(_Native.Identity)')" Text="native library missing from the package inputs: %(_Native.Identity)" />
  </Target>
</Project>
