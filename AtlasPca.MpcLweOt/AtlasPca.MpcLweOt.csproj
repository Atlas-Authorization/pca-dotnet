<Project Sdk="Microsoft.NET.Sdk">
  <!-- The post-quantum endemic (Masny-Rindal) base OT for the MPC package: Kyber-768 K-PKE from the audited pqc_kyber reference, reached by P/Invoke over a
       small C library (liblweot, built from the flagship's crate with cargo and the capi feature). A separate assembly so the core library gains no native
       dependency. Point ATLAS_LWEOT_LIB at the shared library, or put liblweot beside the assembly. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtlasPca.Mpc.LweOt</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <Version>0.5.0</Version>
    <Description>Post-quantum (Kyber-768 K-PKE) endemic base OT for the PCA MPC package, with the liblweot native library for every supported platform.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AtlasPca.Mpc/AtlasPca.Mpc.csproj" />
  </ItemGroup>
  <!-- The native libraries ship per RID in runtimes/<rid>/native (built by the native-package workflow). PackNativeRequired=true (the release job) makes a pack without all of them fail. -->
  <ItemGroup>
    <None Include="runtimes/**/native/*" Pack="true" PackagePath="%(Identity)" Visible="false" />
  </ItemGroup>
  <Target Name="RequireNatives" BeforeTargets="_GetPackageFiles" Condition="'$(PackNativeRequired)' == 'true'">
    <ItemGroup>
      <_Native Include="runtimes/linux-x64/native/liblweot.so;runtimes/linux-arm64/native/liblweot.so;runtimes/osx-x64/native/liblweot.dylib;runtimes/osx-arm64/native/liblweot.dylib;runtimes/win-x64/native/lweot.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(_Native.Identity)')" Text="native library missing from the package inputs: %(_Native.Identity)" />
  </Target>
</Project>
