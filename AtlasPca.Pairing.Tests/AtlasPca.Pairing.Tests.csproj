<Project Sdk="Microsoft.NET.Sdk">
  <!-- Replays the reference corpora and the vendored community vectors through AtlasPca.Pairing. Needs the native library next to the test assembly (Native/build.sh). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AtlasPca/AtlasPca.csproj" />
    <ProjectReference Include="../AtlasPca.Pairing/AtlasPca.Pairing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the shared differential-oracle harness (reads test-data/ref-*.json.gz) -->
    <Compile Include="../AtlasPca.Corpus.Tests/Base.cs" Link="Base.cs" />
    <Compile Include="../AtlasPca.Corpus.Tests/FixtureJson.cs" Link="FixtureJson.cs" />
    <Content Include="test-data/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- libblst.dll.so from Native/build.sh, copied beside the test assembly so DllImport("blst.dll") resolves -->
    <None Include="native/*.so" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
