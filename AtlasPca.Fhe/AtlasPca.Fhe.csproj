<Project Sdk="Microsoft.NET.Sdk">
  <!-- Homomorphic risk-gate evaluation (BFV) on the official Microsoft.Research.SEALNet binding, wire-compatible with the TypeScript package
       (node-seal 5.1.x bundles Microsoft SEAL 4.1.x; SEAL stream headers carry only major.minor, so 4.1.1 and 4.1.2 interoperate).
       A separate assembly so the core library gains no native dependency. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtlasPca.Fhe</RootNamespace>
    <IsPackable>true</IsPackable>
    <Version>0.6.0</Version>
    <Description>Homomorphic risk-gate evaluation (BFV) for PCA on Microsoft.Research.SEALNet, which carries the SEAL native libraries.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Research.SEALNet" Version="4.1.1" />
    <ProjectReference Include="../AtlasPca/AtlasPca.csproj" />
  </ItemGroup>
  <!-- SEALNet ships sealc only for x86-64 (and under non-standard RID folders); this package adds SEAL 4.1.2's C export library per RID in runtimes/<rid>/native,
       built by the native-package workflow. ATLAS_PCA_LIBSEALC overrides. PackNativeRequired=true (the release job) makes a pack without all of them fail. -->
  <ItemGroup>
    <None Include="runtimes/**/native/*" Pack="true" PackagePath="%(Identity)" Visible="false" />
  </ItemGroup>
  <Target Name="RequireNatives" BeforeTargets="_GetPackageFiles" Condition="'$(PackNativeRequired)' == 'true'">
    <ItemGroup>
      <_Native Include="runtimes/linux-x64/native/libsealc.so;runtimes/linux-arm64/native/libsealc.so;runtimes/osx-x64/native/libsealc.dylib;runtimes/osx-arm64/native/libsealc.dylib;runtimes/win-x64/native/sealc.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(_Native.Identity)')" Text="native library missing from the package inputs: %(_Native.Identity)" />
  </Target>
</Project>
